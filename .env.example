[TEMPLATE]
# Supabase PostgreSQL credentials — set them up once in the sibling GEO_E2E: run
# ../GEO_E2E/setup.sh, which writes .env with these five values (manual fallback: copy this
# file to .env and take the values from the Supabase dashboard → Connect → Connection pooling
# → Transaction pooler). See README.md ("Setup" and "Configuration") for details.
SUPABASE_DB_USER=postgres.<YOUR-PROJECT-REF>
SUPABASE_DB_PASSWORD=<YOUR-PASSWORD>
SUPABASE_DB_HOST=aws-1-eu-west-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
