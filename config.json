{
  "app_run": {
    "host": "127.0.0.1",
    "port": 8000,
    "reload": false,
    "log_level": "info"
  },
  "database": {
    "pool_size": 5,
    "max_overflow": 5,
    "pool_recycle_seconds": 300
  },
  "cors_middleware": {
    "allow_origins": ["*"],
    "allow_credentials": false,
    "allow_methods": ["*"],
    "allow_headers": ["*"]
  }
}
